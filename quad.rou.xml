<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5" maxSpeed="70"/>
    
    <vType id="ambulance" vClass="emergency" guiShape="emergency" color="0,0,255" accel="4.0" decel="6.0" maxSpeed="100"/>

    <!-- Routes -->
    <route id="route_top_WE" edges="W1_to_J1 J1_to_J2 J2_to_E2"/>
    <route id="route_top_EW" edges="E2_to_J2 J2_to_J1 J1_to_W1"/>
    
    <route id="route_bottom_WE" edges="W3_to_J3 J3_to_J4 J4_to_E4"/>
    <route id="route_bottom_EW" edges="E4_to_J4 J4_to_J3 J3_to_W3"/>

    <route id="route_left_NS" edges="N1_to_J1 J1_to_J3 J3_to_S3"/>
    <route id="route_left_SN" edges="S3_to_J3 J3_to_J1 J1_to_N1"/>

    <route id="route_right_NS" edges="N2_to_J2 J2_to_J4 J4_to_S4"/>
    <route id="route_right_SN" edges="S4_to_J4 J4_to_J2 J2_to_N2"/>

    <!-- Ambulance route: Top Left to Top Right to Bottom Right -->
    <route id="route_ambulance" edges="W1_to_J1 J1_to_J2 J2_to_J4 J4_to_S4"/>

    <!-- Flows -->
    <flow id="flow_top_WE" type="car" route="route_top_WE" begin="0" end="3600" number="400" />
    <flow id="flow_top_EW" type="car" route="route_top_EW" begin="0" end="3600" number="400" />
    <flow id="flow_bottom_WE" type="car" route="route_bottom_WE" begin="0" end="3600" number="400" />
    <flow id="flow_bottom_EW" type="car" route="route_bottom_EW" begin="0" end="3600" number="400" />

    <flow id="flow_left_NS" type="car" route="route_left_NS" begin="0" end="3600" number="400" />
    <flow id="flow_left_SN" type="car" route="route_left_SN" begin="0" end="3600" number="400" />
    <flow id="flow_right_NS" type="car" route="route_right_NS" begin="0" end="3600" number="400" />
    <flow id="flow_right_SN" type="car" route="route_right_SN" begin="0" end="3600" number="400" />

    <!-- Ambulance -->
    <flow id="ambulance_flow" type="ambulance" route="route_ambulance" begin="100" end="3600" period="200" />
</routes>
